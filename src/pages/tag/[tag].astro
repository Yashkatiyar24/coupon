---
import Base from '../../layouts/Base.astro';
import StoreLogo from '../../components/StoreLogo.astro';
import { brands, catName } from '../../lib/catalog.js';
import { TAGS, REGIONS, discountBadge, tagFaqs, NOW } from '../../lib/content.js';

export function getStaticPaths() {
  return Object.entries(TAGS)
    .map(([tag, def]) => {
      const matches = brands
        .map((b) => ({ brand: b, offers: b.offers.filter(def.test) }))
        .filter((m) => m.offers.length);
      return { params: { tag }, props: { tag, def, matches } };
    })
    .filter((p) => p.props.matches.length); // only tags with real content
}

const { tag, def, matches } = Astro.props;
const total = matches.reduce((n, m) => n + m.offers.length, 0);
const regions = [...new Set(matches.map((m) => m.brand.region).filter(Boolean))];
const questions = tagFaqs(def, matches, total);
const site = Astro.site?.href.replace(/\/$/, '') ?? '';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: `${def.name} Deals`, item: `${site}/tag/${tag}` },
      ],
    },
    {
      '@type': 'ItemList',
      name: `${def.name} deals`,
      numberOfItems: total,
      itemListElement: matches.flatMap(({ brand, offers }) =>
        offers.map((o) => ({
          '@type': 'Offer',
          name: o.title,
          category: brand.category,
          seller: { '@type': 'Organization', name: brand.brand },
          url: o.url ?? brand.affiliateUrl,
          ...(o.expires ? { validThrough: o.expires } : {}),
        }))
      ).map((item, i) => ({ ...item, position: i + 1 })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: questions.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base
  title={`${def.name} Deals & Coupon Codes (${NOW}) — CouponAndDeals`}
  description={`${total} verified ${def.name.toLowerCase()} offers from ${matches.length} stores${regions.length ? ' across the US, UK & India' : ''} — updated for ${NOW}. ${def.blurb.split('.')[0]}.`}
  canonical={`/tag/${tag}`}
  jsonld={jsonld}
>
  <div class="taghero">
    <div class="wrap">
      <p class="crumb"><a href="/">Home</a> / <span>{def.name}</span></p>
      <div class="taghero-main">
        <div class="tagmoji" aria-hidden="true">{def.emoji}</div>
        <div>
          <h1>{def.name} <em>Deals</em> &amp; Offers</h1>
          <p class="tagblurb">{def.blurb}</p>
          <div class="tagstats">
            <span class="vbadge">✔ {total} verified offer{total === 1 ? '' : 's'}</span>
            <span class="statpill">{matches.length} store{matches.length === 1 ? '' : 's'}</span>
            <span class="statpill">Updated {NOW}</span>
            {regions.map((r) => (
              <span class="statpill region">{REGIONS[r].flag} {REGIONS[r].name}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="offergrid" style="margin-top:1.6rem">
      {matches.flatMap(({ brand, offers }) =>
        offers.map((o) => (
          <article class="ocard">
            <div class="top">
              <StoreLogo brand={brand} />
              <div class="tagset">
                {brand.region && REGIONS[brand.region] && (
                  <span class="regionpill">{REGIONS[brand.region].flag} {REGIONS[brand.region].name}</span>
                )}
                <span class={`typetag ${o.code ? 'code' : 'deal'}`}>{o.code ? 'Code' : 'Deal'}</span>
              </div>
            </div>
            <h3 class="headline">{discountBadge(o).toLowerCase().replace(/^./, (c) => c.toUpperCase())} at {brand.brand}</h3>
            <p class="desc">{o.title}</p>
            <p class="meta"><span class="ok">✔ Verified</span> · {catName(brand.category)}</p>
            {o.id && o.url ? (
              <div class="cardact">
                <a class="pillbtn" data-aff href={`/go/${o.id}`} target="_blank" rel="nofollow sponsored">Get Deal</a>
                <a class="morelink" href={`/${brand.slug}-coupon-code`}>All {brand.brand} offers →</a>
              </div>
            ) : (
              <a class="pillbtn" href={`/${brand.slug}-coupon-code`}>See offer</a>
            )}
          </article>
        ))
      )}
    </div>

    <div class="shead"><h2>{def.name} FAQ</h2></div>
    <div class="faq" style="margin-bottom:2.4rem">
      {questions.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</Base>
