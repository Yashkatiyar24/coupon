---
import Base from '../layouts/Base.astro';
import StoreLogo from '../components/StoreLogo.astro';
import { brands, categories, catBrands, initial, totalOffers, dealImage } from '../lib/catalog.js';
import { discountBadge, TAGS, NOW } from '../lib/content.js';

const cap = (s) => s.toLowerCase().replace(/^./, (c) => c.toUpperCase());
// ink text on light brand tiles, white on dark ones
const heroText = (hex) => {
  if (!hex) return '#fff';
  const [r, g, bl] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return (0.299 * r + 0.587 * g + 0.114 * bl) / 255 > 0.6 ? 'var(--ink)' : '#fff';
};
// Tag pages that actually built (same filter as /tag/[tag].astro) → trending row
const trending = Object.entries(TAGS)
  .map(([slug, def]) => ({ slug, def, n: brands.reduce((n, b) => n + b.offers.filter(def.test).length, 0) }))
  .filter((t) => t.n)
  .sort((a, b) => b.n - a.n);

// Amazon-style collection cards: curated Unsplash photo tiles (stable IDs,
// verified 200s), every tile an internal link. Tint fallback if one ever 404s.
const uns = (id, w, h, q = 60) => `https://images.unsplash.com/photo-${id}?w=${w}&h=${h}&fit=crop&q=${q}&auto=format`;
const tileImg = (id) => uns(id, 320, 240, 45);
const tileSet = (id) => `${uns(id, 200, 150, 45)} 200w, ${uns(id, 320, 240, 45)} 320w, ${uns(id, 440, 330, 45)} 440w`;
const heroSet = (id) => `${uns(id, 420, 326, 62)} 420w, ${uns(id, 760, 590, 68)} 760w, ${uns(id, 1100, 854, 68)} 1100w`;
const heroImg = (id) => `https://images.unsplash.com/photo-${id}?w=760&h=590&fit=crop&q=68&auto=format`;
const HERO_IMG = {
  'amazon': '1593359677879-a4bb92f829d1', 'amazon-india': '1524492412937-b28074a5d7da',
  'amazon-uk': '1513635269975-59663e0ac1ad', 'adobe': '1561070791-2526d30994b5',
  'allbirds': '1553062407-98eeb64c6a62', electronics: '1496181133206-80ce9b88a853',
  software: '1555949963-aa79dcee981c', 'home-kitchen': '1556911220-bff31c812dba', delivery: '1526367790999-0150786686a2',
};
const collections = [
  { title: 'Back to School picks', save: 'up to 60% off', link: '/tag/back-to-school', tiles: [
    { img: '1553062407-98eeb64c6a62', b: '-60%', l: 'Backpacks & gear', href: '/tag/back-to-school' },
    { img: '1496181133206-80ce9b88a853', b: '-40%', l: 'Student laptops', href: '/tag/laptop-deals' },
    { img: '1503676260728-1c00da094a0b', b: '-60%', l: 'Student discounts', href: '/tag/student-discount' },
    { img: '1456735190827-d1262f71b8a3', b: 'DEALS', l: 'School supplies', href: '/amazon-coupon-code' },
  ] },
  { title: 'Home & kitchen savings', save: 'up to 45% off', link: '/category/home-kitchen', tiles: [
    { img: '1556911220-bff31c812dba', b: 'DEALS', l: 'Kitchen deals', href: '/tag/kitchen-deals' },
    { img: '1593359677879-a4bb92f829d1', b: '-45%', l: 'TV deals', href: '/tag/tv-deals' },
    { img: '1614633833026-0820552978b6', b: 'NO-COST EMI', l: 'AC deals', href: '/tag/ac-deals' },
    { img: '1513694203232-719a280e022f', b: 'DEALS', l: 'All home offers', href: '/category/home-kitchen' },
  ] },
  { title: 'Smart software savings', save: 'up to 72% off', link: '/category/software', tiles: [
    { img: '1555949963-aa79dcee981c', b: 'FREE TRIAL', l: 'AI tool deals', href: '/category/software' },
    { img: '1561070791-2526d30994b5', b: '-60%', l: 'Creative apps', href: '/adobe-coupon-code' },
    { img: '1563013544-824ae1b704d3', b: '-72%', l: 'VPN plans', href: '/nordvpn-coupon-code' },
    { img: '1499750310107-5fef28a66643', b: 'FREE', l: 'Productivity', href: '/notion-coupon-code' },
  ] },
  { title: 'Shop by region', save: 'up to 70% off', link: '/tag/diwali-sale', tiles: [
    { img: '1524492412937-b28074a5d7da', b: '-70%', l: 'Amazon India', href: '/amazon-india-coupon-code' },
    { img: '1513635269975-59663e0ac1ad', b: '-60%', l: 'Amazon UK', href: '/amazon-uk-coupon-code' },
    { img: '1477764250597-dffe9f601ae8', b: 'FESTIVE', l: 'Diwali sale', href: '/tag/diwali-sale' },
    { img: '1526367790999-0150786686a2', b: '$0 FEES', l: 'Quick delivery', href: '/category/delivery' },
  ] },
];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'CouponAndDeals', url: siteUrl,
      potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
    { '@type': 'Organization', name: 'CouponAndDeals', url: siteUrl, logo: `${siteUrl}/icon-512.png` },
  ],
};
// Top offers = popularity proxy (offer count desc) until click data exists
const top = [...brands].filter((b) => b.offers.length)
  .sort((a, b) => b.offers.length - a.offers.length || a.brand.localeCompare(b.brand))
  .slice(0, 8);
const featured = top.slice(0, 5); // slider
const popular = [...brands].sort((a, b) => b.offers.length - a.offers.length).slice(0, 12);
const catName = (slug) => categories.find((c) => c.slug === slug)?.name ?? slug;
---
<Base
  title={`Coupon Codes, Promo Codes & Deals (${NOW}) — CouponAndDeals`}
  description={`Verified coupon codes, promo codes, and discounts across fashion, electronics, home, beauty, health, travel, software, and delivery. Updated for ${NOW}.`}
  jsonld={jsonld}
>
  <section class="slider" aria-label="Featured deals" aria-roledescription="carousel">
    <div class="slides" id="slides">
      <a class="slide" href="/tag/back-to-school" data-slide>
        <div class="slide-card">
          <span class="slide-photo slide-brand" style="background:#060a1c">
            <b class="sb-big">60% OFF</b>
            <span class="sb-sub">Back to School</span>
          </span>
          <div class="slide-copy">
            <h2>Up to <em>60% Off</em> Back to School Essentials this Week</h2>
            <p class="slide-at">SEASON SPOTLIGHT · US, UK &amp; INDIA</p>
            <p class="slide-data"><span class="ok">✔ Verified</span> · 3 stores · backpacks, laptops &amp; supplies</p>
            <span class="slide-shop">Shop the sale</span>
          </div>
          <span class="slide-photo2"><img src={heroImg('1456735190827-d1262f71b8a3')} srcset={heroSet('1456735190827-d1262f71b8a3')} sizes="(max-width: 860px) 1px, 37vw" alt="" width="760" height="590" loading="eager" fetchpriority="high" decoding="async" onerror="this.remove()" /></span>
        </div>
      </a>
      {featured.map((b, i) => {
        const o = b.offers[0];
        return (
          <a class="slide" href={`/${b.slug}-coupon-code`} data-slide>
            <div class="slide-card">
              <span class="slide-photo slide-brand" style={`background:${b.color ?? 'var(--ink)'}`}>
                <img class="bh-ico" src={`https://www.google.com/s2/favicons?domain=${b.domain}&sz=128`} alt="" width="76" height="76" loading="lazy" decoding="async" onerror="this.remove()" />
                <span class="bh-name" style={`color:${heroText(b.color)};font-size:1.7rem`}>{b.brand}</span>
              </span>
              <div class="slide-copy">
                <h2 set:html={o.title.replace(/(\d+%( off)?|\$\d+( off)?)/i, '<em>$1</em>')} />
                <p class="slide-at">at {b.brand.toUpperCase()}</p>
                <p class="slide-data"><span class="ok">✔ Verified</span> · {b.offers.length} offer{b.offers.length === 1 ? '' : 's'} · {catName(b.category)}</p>
                <span class="slide-shop">Shop now</span>
              </div>
              <span class="slide-photo2"><img src={heroImg(HERO_IMG[b.slug] ?? HERO_IMG[b.category] ?? '1513694203232-719a280e022f')} srcset={heroSet(HERO_IMG[b.slug] ?? HERO_IMG[b.category] ?? '1513694203232-719a280e022f')} sizes="(max-width: 860px) 1px, 37vw" alt="" width="760" height="590" loading="lazy" decoding="async" onerror="this.remove()" /></span>
            </div>
          </a>
        );
      })}
    </div>
    <button class="snav prev" type="button" aria-label="Previous">‹</button>
    <button class="snav next" type="button" aria-label="Next">›</button>
    <div class="dots" id="dots" role="tablist">
      {[...Array(featured.length + 1)].map((_, i) => (
        <button type="button" role="tab" aria-label={`Slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>
      ))}
    </div>
  </section>

  <div class="wrap">
    <div class="shead"><h2>Trending Searches</h2></div>
    <nav class="chiprow" aria-label="Trending deal topics" style="padding-top:0">
      {trending.map((t) => (
        <a class="tagpill" href={`/tag/${t.slug}`}>{t.def.name} <span class="chipcount">{t.n}</span></a>
      ))}
    </nav>

    <div class="quadrow">
      {collections.map((c) => (
        <section class="quad">
          <div class="qhead"><h3>{c.title}</h3><span class="qsave">{c.save}</span></div>
          <div class="qgrid">
            {c.tiles.map((t) => (
              <a href={t.href}>
                <span class="qimg">
                  <img src={tileImg(t.img)} srcset={tileSet(t.img)} sizes="(max-width: 620px) 45vw, (max-width: 1100px) 22vw, 130px" alt="" width="320" height="240" loading="lazy" decoding="async" onerror="this.remove()" />
                  {t.b && (
                    <span class="qoff">
                      {/^-\d+%$/.test(t.b)
                        ? <><b>{t.b.slice(1)}</b><i>OFF</i></>
                        : <b class="txt">{t.b}</b>}
                    </span>
                  )}
                </span>
                <span class="ql">{t.l}</span>
              </a>
            ))}
          </div>
          <a class="qmore" href={c.link}>Shop now →</a>
        </section>
      ))}
    </div>

    <div class="shead"><h2>Today's Top Offers</h2></div>
    <div class="offergrid">
      {top.map((b) => {
        const o = b.offers[0];
        return (
          <article class="ocard img-card">
            <div class="brandhero" style={`background:${b.color ?? 'var(--ink)'}`}>
              <img class="bh-ico" src={`https://www.google.com/s2/favicons?domain=${b.domain}&sz=128`} alt="" width="44" height="44" loading="lazy" decoding="async" onerror="this.remove()" />
              <span class="bh-name" style={`color:${heroText(b.color)}`}>{b.brand}</span>
              <span class="bh-chip">🔥 {discountBadge(o)}</span>
            </div>
            <div class="ocard-body">
              <p class="storename">{b.brand}</p>
              {(() => { const bg = discountBadge(o); const m = bg.match(/^(\d+%|\$\d+) OFF$/);
                if (m) return <><p class="dealbig"><b>{m[1]}</b><i>OFF</i></p><p class="desc">{o.title}</p></>;
                if (!['DEAL', 'CODE'].includes(bg)) return <><p class="dealbig"><b class="tx">{bg}</b></p><p class="desc">{o.title}</p></>;
                return <h3 class="headline" style="margin:0">{o.title}</h3>; })()}
              <p class="meta"><span class="ok">✔ Verified</span> · {catName(b.category)}</p>
              <div class="tear"><a class="pillbtn" href={`/${b.slug}-coupon-code`}>See offer</a></div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="shead"><h2>Popular Stores</h2></div>
    <ul class="storegrid" data-store-grid>
      {popular.map((b) => (
        <li>
          <a class="storec" href={`/${b.slug}-coupon-code`} data-name={b.brand.toLowerCase()}>
            <StoreLogo brand={b} />
            <span class="nm">{b.brand}</span>
            <span class="ct">{b.offers.length} offer{b.offers.length === 1 ? '' : 's'}</span>
          </a>
        </li>
      ))}
    </ul>

    {categories.map((cat) => (
      <>
        <div class="shead">
          <h2>{cat.name}</h2>
          <a href={`/category/${cat.slug}`}>View all →</a>
        </div>
        <ul class="storegrid">
          {catBrands(cat.slug).map((b) => (
            <li>
              <a class="storec" href={`/${b.slug}-coupon-code`} data-name={b.brand.toLowerCase()}>
                <StoreLogo brand={b} />
                <span class="nm">{b.brand}</span>
                <span class="ct">{b.offers.length} offer{b.offers.length === 1 ? '' : 's'}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))}

    <section class="seoblurb">
      <h2>Verified coupon codes &amp; deals, updated daily</h2>
      <p>CouponAndDeals tracks working promo codes, coupon codes, and discounts from {brands.length}+ stores across fashion, electronics, home &amp; kitchen, beauty, health, travel, AI &amp; software, sustainable brands, and food delivery — for shoppers in the United States, United Kingdom, and India. Expired offers are pruned automatically, so what you see is what works today, {NOW}.</p>
      <p>Popular right now: <a href="/tag/back-to-school">back to school deals</a>, <a href="/tag/tv-deals">TV deals</a>, <a href="/tag/iphone-deals">iPhone deals</a>, <a href="/amazon-coupon-code">Amazon coupon codes</a>, and <a href="/tag/free-shipping">free shipping offers</a>.</p>
    </section>
  </div>

  <script>
    // Header search lands here as /?q=…: prefill the box and filter store tiles.
    const q = new URLSearchParams(location.search).get('q')?.trim().toLowerCase() ?? '';
    const input = document.querySelector('.hsearch input');
    const apply = (term) => {
      document.querySelectorAll('[data-name]').forEach((a) => {
        a.closest('li').style.display = !term || a.dataset.name.includes(term) ? '' : 'none';
      });
    };
    if (q && input) { input.value = q; apply(q); }
    input?.addEventListener('input', () => apply(input.value.trim().toLowerCase()));

    // Hero slider: scroll-snap track + dots + prev/next + auto-advance (pauses on hover).
    const track = document.getElementById('slides');
    if (track) {
      const slides = [...track.querySelectorAll('[data-slide]')];
      const dots = [...document.querySelectorAll('[data-dot]')];
      let idx = 0, timer;
      const go = (i) => {
        idx = (i + slides.length) % slides.length;
        const el = slides[idx];
        track.scrollTo({ left: el.offsetLeft - (track.clientWidth - el.clientWidth) / 2, behavior: 'smooth' });
      };
      const sync = () => {
        const c = track.scrollLeft + track.clientWidth / 2;
        let best = 0, bd = Infinity;
        slides.forEach((el, n) => { const d = Math.abs(el.offsetLeft + el.clientWidth / 2 - c); if (d < bd) { bd = d; best = n; } });
        dots.forEach((d, n) => d.setAttribute('aria-current', n === best ? 'true' : 'false'));
        idx = best;
      };
      track.addEventListener('scroll', () => window.requestAnimationFrame(sync), { passive: true });
      dots.forEach((d, n) => d.addEventListener('click', () => go(n)));
      document.querySelector('.snav.prev')?.addEventListener('click', () => go(idx - 1));
      document.querySelector('.snav.next')?.addEventListener('click', () => go(idx + 1));
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const start = () => { if (!still) timer = setInterval(() => go(idx + 1), 5000); };
      const stop = () => clearInterval(timer);
      track.addEventListener('pointerenter', stop);
      track.addEventListener('pointerleave', start);
      start();
    }
  </script>
</Base>
